---
import Section from '../Section.astro';
import { manifest } from '../../content/site';
---
<Section id="manifest" tone="light" class="manifest">
  <h2 id="manifest-title" class="eyebrow" set:html={manifest.eyebrow} />
  <p class="quote" set:html={manifest.quote} />
  <div class="cols">
    <p class="lead" set:html={manifest.lead} />
    <p class="text" set:html={manifest.text} />
  </div>
</Section>

<style>
  .manifest { gap: 48px; }
  .quote {
    max-width: 1060px;
    font-style: italic;
    font-size: clamp(32px, 4.4vw, 60px);
    line-height: 1.08;
    color: var(--heading);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gap-col);
    row-gap: 24px;
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }
  .lead { line-height: 1.22; }
  @media (max-width: 900px) {
    .manifest { gap: 36px; }
    .cols { grid-template-columns: 1fr; }
  }
</style>
