---
import Section from '../Section.astro';
import { contact, kontakt as s } from '../../content/site';
---
<Section id="kontakt" tone="light" class="kontakt">
  <div class="cols">
    <div class="intro">
      <p class="eyebrow" set:html={s.eyebrow} />
      <h2 id="kontakt-title" set:html={s.title} />
      <p class="invite" set:html={s.text} />
    </div>
    <div class="channels">
      <div class="channel">
        <p class="eyebrow">Telefon</p>
        <a href={contact.phoneHref} class="phone">{contact.phone}</a>
      </div>
      <div class="channel">
        <p class="eyebrow">E-mail</p>
        <a href={`mailto:${contact.email}`} class="email">{contact.email}</a>
      </div>
    </div>
  </div>
  <footer>
    <span class="brand">ZALEWSKA</span>
    <span class="claim">{s.footerClaim}</span>
    <span class="eyebrow copy">{s.copyright}</span>
  </footer>
</Section>

<style>
  .kontakt { padding-bottom: 0; }
  .cols {
    flex: 1;
    display: grid;
    grid-template-columns: 7fr 5fr;
    column-gap: var(--gap-col);
    row-gap: 48px;
    align-items: center;
    padding-bottom: 72px;
  }
  .intro { display: flex; flex-direction: column; gap: 32px; }
  h2 {
    font-style: italic;
    font-weight: 400;
    font-size: clamp(48px, 5.9vw, 80px);
    line-height: 1.02;
    color: var(--heading);
  }
  .invite { max-width: 520px; font-size: 22px; line-height: 1.5; }
  .channels {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-left: 48px;
    border-left: 1px solid var(--rule);
    font-family: var(--font-display);
    font-weight: 600;
  }
  .channel { display: flex; flex-direction: column; gap: 10px; }
  .channel a { color: var(--ink); overflow-wrap: anywhere; }
  .channel a:hover { color: var(--accent); }
  .phone { font-size: clamp(24px, 7vw, 30px); }
  .email { font-size: clamp(19px, 5.6vw, 24px); }
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
    min-height: 96px;
    border-top: 1px solid var(--rule);
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.24em;
    color: var(--ink);
  }
  .claim { font-style: italic; font-size: 17px; color: var(--light-label); }
  .copy { color: var(--light-muted); }
  /* design: content centred in the area above the 96px footer, no top padding */
  @media (min-width: 1025px) {
    .kontakt { padding-top: 0; }
    .cols { padding-bottom: 0; }
  }
  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr; }
    .channels {
      padding-left: 0;
      padding-top: 32px;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 720px) {
    .invite { font-size: 19px; }
    footer { flex-direction: column; align-items: flex-start; padding: 24px 0; }
  }
</style>
