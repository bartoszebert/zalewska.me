---
import Section from '../Section.astro';
import { kwalifikacje as s } from '../../content/site';
---
<Section id="kwalifikacje" tone="dark" class="kwalifikacje">
  <div class="intro">
    <p class="eyebrow" set:html={s.eyebrow} />
    <h2 id="kwalifikacje-title" class="h2" set:html={s.title} />
    <p class="lead" set:html={s.lead} />
  </div>
  <div>
    <ul class="fields">
      {s.fields.map((field) => (
        <li>
          <h3 class="title" set:html={field.title} />
          <p class="text-sm muted" set:html={field.text} />
        </li>
      ))}
    </ul>
    <p class="eyebrow more" set:html={s.more} />
  </div>
</Section>

<style>
  .kwalifikacje {
    display: grid;
    grid-template-columns: 5fr 7fr;
    column-gap: var(--gap-col);
    row-gap: 56px;
    align-items: center;
    align-content: center;
  }
  .intro { display: flex; flex-direction: column; gap: 28px; }
  li {
    display: grid;
    grid-template-columns: 4fr 7fr;
    column-gap: 36px;
    row-gap: 8px;
    align-items: baseline;
    padding: 20px 0;
    border-top: 1px solid var(--rule);
  }
  li:last-child { border-bottom: 1px solid var(--rule); }
  h3 { font-size: 20px; }
  .more { padding-top: 22px; color: var(--dim); }
  @media (max-width: 900px) {
    .kwalifikacje { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    li { grid-template-columns: 1fr; }
    h3 { font-size: 19px; }
  }
</style>
